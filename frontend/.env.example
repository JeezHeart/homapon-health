# Copy to .env and fill in. No secrets here (just local URLs/keys).
# Empty/unset VITE_API_URL = demo mode (local fictional data).
VITE_API_URL=http://localhost:3001/api
# Supabase project + PUBLISHABLE key (public by design; RLS + backend
# roles are the real protection). Needed only when VITE_API_URL is set.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=paste-publishable-key-here
