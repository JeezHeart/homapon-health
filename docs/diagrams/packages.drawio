<mxfile host="app.diagrams.net"><diagram id="packages" name="Figure 13 - Package Diagram"><mxGraphModel dx="1380" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1380" pageHeight="1000" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="figure-title" value="FIGURE 13. PACKAGE DIAGRAM" style="whiteSpace=wrap;html=0;rounded=0;fontFamily=Courier New;fontSize=24;fontColor=#000000;strokeColor=#000000;fillColor=none;spacing=8;text;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1300" height="38" as="geometry"/></mxCell><mxCell id="figure-status" value="Simplified program groups; arrows show which part uses another" style="whiteSpace=wrap;html=0;rounded=0;fontFamily=Courier New;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=none;spacing=8;text;strokeColor=none;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1300" height="26" as="geometry"/></mxCell><mxCell id="pages" value="SCREENS AND FORMS&#xa;Child records and appointments&#xa;Reports and reminders&#xa;Buttons and entry forms" style="whiteSpace=wrap;html=0;rounded=0;fontFamily=Courier New;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="360" height="150" as="geometry"/></mxCell><mxCell id="state" value="STAFF ACTIONS&#xa;Tracks sign-in and screen data&#xa;Passes entries for checking&#xa;Shows the returned result" style="whiteSpace=wrap;html=0;rounded=0;fontFamily=Courier New;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="510" y="135" width="360" height="150" as="geometry"/></mxCell><mxCell id="domain" value="GUIDES AND DATE RULES&#xa;Vaccine names and doses&#xa;Dates and appointment status&#xa;Practice records for demo use" style="whiteSpace=wrap;html=0;rounded=0;fontFamily=Courier New;fontSize=18;fontColor=#000000;strokeColor=#000000;fillColor=#f