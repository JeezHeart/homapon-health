# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Get these from Supabase Dashboard > Project Settings > API.
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
# service_role key: full DB access, server-side ONLY. Never put in frontend code.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
# Comma-separated origins allowed to call the API (no trailing slashes —
# cors matches exactly, so http://localhost:5173/ would NOT match).
CORS_ORIGINS=http://localhost:5173
# iProg SMS (Phase 5). API token is a SECRET: server .env only, never
# frontend/chat/screenshots.
IPROG_API_TOKEN=paste-iprog-api-token-here
# Safety default: true = log sends WITHOUT calling the SMS provider.
# Set to false only for an approved live test with load credits.
SMS_DRY_RUN=true
SMS_PROVIDER=iprog
# Disabled until a live test is authorized.
SMS_ENABLED=false
# Optional local verification credentials. Never put real passwords in this template.
TEST_MIDWIFE_EMAIL=
TEST_MIDWIFE_PASSWORD=
TEST_BHW_EMAIL=
TEST_BHW_PASSWORD=

# Disabled until a live test is authorized.

# Optional Phase 3 guidance. Use a GroqCloud Free-plan key on the backend only.
# Leave blank for built-in reference guidance. No billing activation is required.
GROQ_API_KEY=
