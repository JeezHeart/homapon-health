# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Get these from Supabase Dashboard > Project Settings > API.
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
# service_role key: full DB access, server-side ONLY. Never put in frontend code.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
# Comma-separated origins allowed to call the API (no trailing slashes —
# cors matches exactly, so http://localhost:5173/ would NOT match).
CORS_ORIGINS=http://localhost:5173
# Semaphore SMS (Phase 5). API key is a SECRET: server .env only, never
# frontend/chat/screenshots. Sender name is shown on the recipient phone.
SEMAPHORE_API_KEY=paste-semaphore-api-key-here
SEMAPHORE_SENDER_NAME=HomaponHC
# Safety default: true = log sends WITHOUT calling ANY provider.
# Set to false only for an approved live test with load credits.
SEMAPHORE_DRY_RUN=true
# SMS provider: semaphore (paper default) or unisms (free test credits).
# Needs UNISMS_SECRET_KEY below; sender Unisoft reaches Globe/DITO only.
SMS_PROVIDER=semaphore
UNISMS_SECRET_KEY=paste-unisms-secret-key-here
UNISMS_SENDER_ID=Unisoft

# Optional local verification credentials. Never put real passwords in this template.
TEST_MIDWIFE_EMAIL=
TEST_MIDWIFE_PASSWORD=
TEST_BHW_EMAIL=
TEST_BHW_PASSWORD=

# Disabled until the sender name is approved and a live test is authorized.
SMS_ENABLED=false
